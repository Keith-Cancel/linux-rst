builddir  = ./build
obj_dir   = $builddir/obj
bin_dir   = $builddir/bin

cc       = gcc
c_libs   =
c_inc    = -I./include
c_opt    = -O2 -march=native
c_extra  = -fdiagnostics-color=always
c_flags  = -std=c11 -fno-ident 
c_warn   = -Wall -Wextra -Wshadow -Wpedantic -Wstrict-aliasing=1
c_define =

# ~~~~~~~~~~~ RULES ~~~~~~~~~~~
rule cc
    command = $cc $c_opt $c_flags $c_extra $c_warn -c $in -o $out $c_inc $c_define

rule link
    command = $cc $in -o $out $c_libs $c_inc

rule touch
    command = touch $out

# ~~~~~~ BUILD COMMANDS ~~~~~~~
build $obj_dir/main.o:       cc ./src/main.c
build $obj_dir/fldr.o:       cc ./src/fldr.c     | ./include/fldr.h     ./include/flex_arr.h 
build $obj_dir/flex_arr.o:   cc ./src/flex_arr.c | ./include/flex_arr.h ./include/math_chk.h ./include/xmem.h
build $obj_dir/xmem.o:       cc ./src/xmem.c     | ./include/xmem.h

# ~~~~~~~ LINK COMMANDS ~~~~~~~
build ./cffi: link $obj_dir/main.o $obj_dir/flex_arr.o $obj_dir/xmem.o
