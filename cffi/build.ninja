builddir  = ./build
obj_dir   = $builddir/obj
bin_dir   = $builddir/bin

cc       = gcc
c_libs   =
c_inc    = -iquote ./include
c_opt    = -O2 -march=native
c_extra  = 
c_flags  = -std=c99 -fno-ident -fdiagnostics-color=always
c_warn   = -Wall -Wextra -Wshadow -Wpedantic -Wstrict-aliasing=1
c_define =

# ~~~~~~~~~~~ RULES ~~~~~~~~~~~
rule cc
    command = $cc $c_opt $c_flags $c_extra $c_warn -c $in -o $out $c_inc $c_define

rule link
    command = $cc $in -o $out $c_libs $c_inc

rule touch
    command = touch $out

build core_hdrs: phony ./include/types.h ./include/util.h

# ~~~~~~ BUILD COMMANDS ~~~~~~~
build $obj_dir/main.o:       cc ./src/main.c     | core_hdrs
build $obj_dir/fldr.o:       cc ./src/fldr.c     | core_hdrs ./include/fldr.h     ./include/flex_arr.h ./include/xmem.h
build $obj_dir/flex_arr.o:   cc ./src/flex_arr.c | core_hdrs ./include/flex_arr.h ./include/math_chk.h ./include/xmem.h
build $obj_dir/xmem.o:       cc ./src/xmem.c     | core_hdrs ./include/xmem.h

# ~~~~~~~ LINK COMMANDS ~~~~~~~
build ./cffi: link $obj_dir/main.o $obj_dir/fldr.o $obj_dir/flex_arr.o $obj_dir/xmem.o
