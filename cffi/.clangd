If:
  PathMatch: .*\.c
CompileFlags:
  Compiler: clang
  Add: [
    -xc,
    -std=c11,
    -O2,
    -Wall,
    -Wextra,
    -Wshadow,
    -Wpedantic,
  ]
---
If:
  PathMatch: .*\.h
CompileFlags:
  Compiler: clang
  Add: [
    -xc-header,
    -std=c11,
    -O2,
    -Wall,
    -Wextra,
    -Wshadow,
    -Wpedantic,
  ]
